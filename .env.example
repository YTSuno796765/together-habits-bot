# Copy to .env and fill in your own values. Never commit .env.
# Bot token from @BotFather goes after the equals sign:
TELEGRAM_BOT_TOKEN=
HABITS_DB_PATH=habits.db
HABITS_TIMEZONE=Europe/Moscow

# Mini App (optional). Telegram requires a public HTTPS address.
# The VPS installer fills this in automatically.
WEBAPP_URL=
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080

# Optional: your numeric Telegram user id to receive a weekly database backup.
HABITS_ADMIN_ID=
